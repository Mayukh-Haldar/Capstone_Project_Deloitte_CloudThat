  "components": {
    "schemas": {
      "CheckInScanRequest": {
        "required": [
          "qrPayload",
          "gate"
        ],
        "type": "object",
        "properties": {
          "qrPayload": {
            "type": "string"
          },
          "gate": {
            "type": "string"
          }
        }
      },
      "CheckInStatsResponse": {
        "required": [
          "eventId",
          "totalRegistrations",
          "checkedInCount",
          "pendingCount",
          "checkInRate",
          "recentCheckIns"
        ],
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "totalRegistrations": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "checkedInCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "pendingCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "checkInRate": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "recentCheckIns": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RecentCheckInResponse"
            }
          }
        }
      },
      "CreateTicketTypeRequest": {
        "required": [
          "ticketName",
          "tierCode",
          "price",
          "totalQuantity",
          "maxPerOrder",
          "description",
          "saleStartsAt",
          "saleEndsAt"
        ],
        "type": "object",
        "properties": {
          "ticketName": {
            "type": "string"
          },
          "tierCode": {
            "type": "string"
          },
          "price": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "totalQuantity": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "maxPerOrder": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "description": {
            "type": [
              "null",
              "string"
            ]
          },
          "saleStartsAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "saleEndsAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "CsvImportResponse": {
        "required": [
          "importedCount",
          "errors"
        ],
        "type": "object",
        "properties": {
          "importedCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "JoinWaitlistRequest": {
        "required": [
          "ticketTypeId",
          "firstName",
          "lastName",
          "email",
          "phone"
        ],
        "type": "object",
        "properties": {
          "ticketTypeId": {
            "type": "string",
            "format": "uuid"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "RecentCheckInResponse": {
        "required": [
          "registrationId",
          "ticketId",
          "gate",
          "checkInTime"
        ],
        "type": "object",
        "properties": {
          "registrationId": {
            "type": "string",
            "format": "uuid"
          },
          "ticketId": {
            "type": "string",
            "format": "uuid"
          },
