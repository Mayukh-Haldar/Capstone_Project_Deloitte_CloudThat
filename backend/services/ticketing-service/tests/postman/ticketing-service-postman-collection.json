                  "pm.test('Status is PENDING', () => pm.expect(body.status).to.eql('PENDING'));",
                  "pm.test('Has registrationId', () => pm.expect(body.registrationId).to.be.a('string'));",
                  "pm.test('Has ticket with QR payload', () => {",
