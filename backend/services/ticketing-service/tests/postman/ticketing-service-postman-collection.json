{
  "info": {
    "_postman_id": "eventzen-ticketing-collection",
    "name": "EventZen – Ticketing Service",
    "description": "System-level tests for the EventZen Ticketing Service (port 8084).\n\nPre-requisites\n──────────────\n1. event-service is running on {{eventBaseUrl}}.\n2. ticketing-service is running on {{baseUrl}}.\n3. The services are reachable on localhost so the local x-user-* development fallback can be used.\n\nHow to run\n──────────\nPostman: Collection Runner → select environment 'EventZen Ticketing Service – Local'\nNewman: newman run ticketing-service-postman-collection.json -e ticketing-service-postman-environment.json\n\nThis collection bootstraps its own category lookup and event lifecycle setup before exercising ticketing APIs.\n\nTest IDs: TKT-ST-001 … TKT-ST-020",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [],
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "TKT-ST-000A – List categories",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const categories = pm.response.json();",
                  "pm.test('Categories available', () => pm.expect(categories).to.be.an('array').and.not.empty);",
                  "pm.environment.set('categoryId', categories[0].id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{eventBaseUrl}}/api/v1/categories"
          }
        },
        {
          "name": "TKT-ST-000B – Create event (ORGANIZER)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Event starts pending approval', () => pm.expect(body.event.status).to.eql('PENDING_APPROVAL'));",
                  "pm.environment.set('eventId', body.event.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer local-dev-organizer" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-user-id", "value": "{{organizerUserId}}" },
              { "key": "x-user-email", "value": "{{organizerEmail}}" },
              { "key": "x-user-roles", "value": "ORGANIZER" }
            ],
            "url": "{{eventBaseUrl}}/api/v1/events",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": \"{{categoryId}}\",\n  \"title\": \"Ticketing Postman Event {{$timestamp}}\",\n  \"eventType\": \"CONFERENCE\",\n  \"description\": \"Ticketing system test event created automatically.\",\n  \"startTime\": \"2030-11-15T09:00:00Z\",\n  \"endTime\": \"2030-11-15T18:00:00Z\",\n  \"expectedAttendees\": 120,\n  \"capacity\": 250,\n  \"estimatedBudget\": 60000,\n  \"recurrenceRule\": \"NONE\",\n  \"tags\": [\"ticketing\", \"postman\"],\n  \"agendaItems\": [\n    {\n      \"agendaTitle\": \"Opening Session\",\n      \"type\": \"KEYNOTE\",\n      \"startTime\": \"2030-11-15T09:00:00Z\",\n      \"endTime\": \"2030-11-15T10:00:00Z\"\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "TKT-ST-000C – Approve event (ADMIN)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Event moves to DRAFT', () => pm.expect(pm.response.json().event.status).to.eql('DRAFT'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer local-dev-admin" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-user-id", "value": "{{adminUserId}}" },
              { "key": "x-user-email", "value": "{{adminEmail}}" },
              { "key": "x-user-roles", "value": "ADMIN" }
            ],
            "url": "{{eventBaseUrl}}/api/v1/events/{{eventId}}/approval/approve",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"approvedBudget\": 60000,\n  \"note\": \"Approved for ticketing system tests.\"\n}"
            }
          }
        },
        {
          "name": "TKT-ST-000D – Open registration (ORGANIZER)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Event opens registration', () => pm.expect(pm.response.json().event.status).to.eql('REGISTRATION_OPEN'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer local-dev-organizer" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-user-id", "value": "{{organizerUserId}}" },
              { "key": "x-user-email", "value": "{{organizerEmail}}" },
              { "key": "x-user-roles", "value": "ORGANIZER" }
            ],
            "url": "{{eventBaseUrl}}/api/v1/events/{{eventId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"REGISTRATION_OPEN\"\n}"
            }
          }
        }
      ]
    },
