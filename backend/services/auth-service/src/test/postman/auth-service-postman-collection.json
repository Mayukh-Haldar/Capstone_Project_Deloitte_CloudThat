{
  "info": {
    "_postman_id": "evz-auth-collection-v1",
    "name": "EventZen — Auth Service",
    "description": "System tests for the EventZen Auth Service covering all 26 API endpoints.\n\nSystem test IDs: AUTH-ST-001 through AUTH-ST-026\n\nPre-requisites:\n- Auth service running on {{baseUrl}} (default: http://localhost:8081)\n- Run the '00 - Bootstrap Admin Token' request first to populate adminAccessToken\n- Run the '01 - Register User' request to create a test user before user-specific tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [],
  "item": [
    {
      "name": "Authentication",
      "description": "All /api/v1/auth/* endpoints",
      "item": [
        {
          "name": "Auth-ST-001 — Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Response has accessToken', () => pm.expect(json.accessToken).to.be.a('string').and.not.empty);",
                  "pm.test('Response has refreshToken', () => pm.expect(json.refreshToken).to.be.a('string').and.not.empty);",
                  "pm.test('User email matches', () => pm.expect(json.user.email).to.eql(pm.environment.get('testEmail')));",
                  "pm.environment.set('accessToken', json.accessToken);",
                  "pm.environment.set('refreshToken', json.refreshToken);",
                  "pm.environment.set('userId', json.user.id);",
                  "const verifyToken = pm.response.headers.get('X-Debug-Email-Verification-Token');",
                  "if (verifyToken) { pm.environment.set('emailVerificationToken', verifyToken); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Postman\",\n  \"lastName\": \"User\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"requestedRole\": \"ATTENDEE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "register"]
            }
          }
        },
