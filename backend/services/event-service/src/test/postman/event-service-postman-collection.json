{
  "info": {
    "name": "EventZen — Event Service",
    "description": "System tests for the Event Service (port 8082). Run requests in order within each folder. Requires auth-service (port 8081) to be running to obtain JWT tokens.\n\nSystem Test IDs: EVENT-ST-001 to EVENT-ST-021",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Setup: Auth Tokens",
      "description": "Login via auth-service to get JWT tokens. Run these once before the main tests.",
      "item": [
        {
          "name": "EVENT-ST-001 Login as Organizer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{authBaseUrl}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{organizerEmail}}\",\n  \"password\": \"{{organizerPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login successful', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.environment.set('organizerToken', body.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "EVENT-ST-002 Login as Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{authBaseUrl}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Admin login successful', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.environment.set('adminToken', body.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "EVENT-ST-003 List Categories",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/categories"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns 200 with categories', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const cats = pm.response.json();",
                  "  pm.expect(cats).to.be.an('array').and.not.empty;",
                  "  pm.environment.set('categoryId', cats[0].id);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Event Lifecycle",
      "description": "Create, read, update, session management, and status transitions for an event.",
      "item": [
        {
          "name": "EVENT-ST-004 Create Event (Organizer)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{organizerToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/events",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": \"{{categoryId}}\",\n  \"title\": \"Postman Test Event — Cloud Summit 2030\",\n  \"eventType\": \"CONFERENCE\",\n  \"description\": \"System test event created via Postman for end-to-end validation.\",\n  \"startTime\": \"2030-11-15T09:00:00Z\",\n  \"endTime\":   \"2030-11-15T18:00:00Z\",\n  \"expectedAttendees\": 150,\n  \"capacity\": 400,\n  \"estimatedBudget\": 80000,\n  \"recurrenceRule\": \"NONE\",\n  \"tags\": [\"cloud\", \"postman\"],\n  \"agendaItems\": [\n    {\n      \"agendaTitle\": \"Opening Keynote\",\n      \"type\": \"KEYNOTE\",\n      \"startTime\": \"2030-11-15T09:00:00Z\",\n      \"endTime\":   \"2030-11-15T10:00:00Z\"\n    },\n    {\n      \"agendaTitle\": \"Workshop: Serverless\",\n      \"type\": \"WORKSHOP\",\n      \"startTime\": \"2030-11-15T10:30:00Z\",\n      \"endTime\":   \"2030-11-15T12:00:00Z\"\n    }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Event created as PENDING_APPROVAL', () => {",
                  "  pm.response.to.have.status(201);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.event.status).to.equal('PENDING_APPROVAL');",
                  "  pm.expect(body.event.approvalStatus).to.equal('PENDING');",
                  "  pm.environment.set('eventId', body.event.id);",
                  "  pm.environment.set('eventIdl', body.event.id);",
                  "  pm.environment.set('eventld', body.event.id);",
                  "  pm.collectionVariables.set('eventId', body.event.id);",
                  "  pm.collectionVariables.set('eventIdl', body.event.id);",
                  "  pm.collectionVariables.set('eventld', body.event.id);",
                  "  pm.variables.set('eventId', body.event.id);",
                  "  pm.variables.set('eventIdl', body.event.id);",
                  "  pm.variables.set('eventld', body.event.id);",
                  "  if (body.agendaItems && body.agendaItems.length >= 2) {",
                  "    pm.environment.set('agendaItemId1', body.agendaItems[0].id);",
                  "    pm.environment.set('agendaItemId2', body.agendaItems[1].id);",
                  "    pm.collectionVariables.set('agendaItemId1', body.agendaItems[0].id);",
                  "    pm.collectionVariables.set('agendaItemId2', body.agendaItems[1].id);",
                  "    pm.variables.set('agendaItemId1', body.agendaItems[0].id);",
                  "    pm.variables.set('agendaItemId2', body.agendaItems[1].id);",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "EVENT-ST-005 Get Event (Public)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/events/{{eventId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns event detail', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.event.id).to.equal(pm.environment.get('eventId'));",
                  "  pm.expect(body.event.title).to.include('Cloud Summit');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "EVENT-ST-006 List Events (Public)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/events?q=Cloud+Summit&page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "events"],
              "query": [
                { "key": "q", "value": "Cloud Summit" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns paged list', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.content).to.be.an('array');",
                  "  pm.expect(body.totalElements).to.be.at.least(1);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "EVENT-ST-007 Update Event (Organizer)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{organizerToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/events/{{eventId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman Test Event — Cloud Summit 2030 (Updated)\",\n  \"description\": \"Updated description via Postman system test.\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Event updated', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.event.title).to.include('Updated');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "EVENT-ST-008 Add Session",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{organizerToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/events/{{eventId}}/sessions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionTitle\": \"Deep Dive: Kubernetes\",\n  \"speakerName\": \"Dr. Jane Smith\",\n  \"room\": \"Hall A\",\n  \"sessionType\": \"TALK\",\n  \"startTime\": \"2030-11-15T14:00:00Z\",\n  \"endTime\":   \"2030-11-15T15:30:00Z\",\n  \"capacity\": 200\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Session created', () => {",
                  "  pm.response.to.have.status(201);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.sessionTitle).to.equal('Deep Dive: Kubernetes');",
                  "  pm.environment.set('sessionId', body.id);",
                  "  pm.collectionVariables.set('sessionId', body.id);",
                  "  pm.variables.set('sessionId', body.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "EVENT-ST-009 Get Agenda (Public)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/events/{{eventId}}/agenda"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns agenda array', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "EVENT-ST-010 Reorder Agenda",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{organizerToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/events/{{eventId}}/agenda/reorder",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"agendaItemIds\": [\"{{agendaItemId2}}\", \"{{agendaItemId1}}\"]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Agenda reordered', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Approval Workflow",
      "description": "Admin approves the event, then organizer transitions status.",
      "item": [
        {
          "name": "EVENT-ST-011 Approve Event (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/events/{{eventId}}/approval/approve",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "events", "{{eventId}}", "approval", "approve"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"approvedBudget\": 80000,\n  \"note\": \"Approved after review.\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Event approved → DRAFT', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.event.approvalStatus).to.equal('APPROVED');",
                  "  pm.expect(body.event.status).to.equal('DRAFT');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "EVENT-ST-012 Transition Status → PUBLISHED",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/events/{{eventId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "events", "{{eventId}}", "status"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"PUBLISHED\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status transitioned to PUBLISHED', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().event.status).to.equal('PUBLISHED');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "EVENT-ST-013 Transition Status → REGISTRATION_OPEN",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{organizerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/events/{{eventId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "events", "{{eventId}}", "status"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"REGISTRATION_OPEN\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Registration opened', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().event.status).to.equal('REGISTRATION_OPEN');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Disable / Enable Flow",
      "description": "Admin disables the event, organizer requests re-enable, admin approves.",
      "item": [
        {
          "name": "EVENT-ST-014 Disable Event (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/events/{{eventId}}/disable",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "events", "{{eventId}}", "disable"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Event disabled by admin', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().event.status).to.equal('DISABLED_BY_ADMIN');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "EVENT-ST-015 Request Re-Enable (Organizer)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{organizerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/events/{{eventId}}/request-enable",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "events", "{{eventId}}", "request-enable"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"note\": \"All issues have been resolved. Ready to reopen.\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Enable request submitted', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.equal('PENDING');",
                  "  pm.environment.set('enableRequestId', body.requestId);",
                  "  pm.collectionVariables.set('enableRequestId', body.requestId);",
                  "  pm.variables.set('enableRequestId', body.requestId);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "EVENT-ST-016 List Enable Requests (Admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/events/enable-requests",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "events", "enable-requests"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Enable requests listed', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json()).to.be.an('array').and.not.empty;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "EVENT-ST-017 Approve Enable Request (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/events/enable-requests/{{enableRequestId}}/approve",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "events", "enable-requests", "{{enableRequestId}}", "approve"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"note\": \"Approved. Event re-enabled.\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Event re-enabled', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().event.status).not.to.equal('DISABLED_BY_ADMIN');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Cleanup",
      "description": "Delete the test session and event.",
      "item": [
        {
          "name": "EVENT-ST-018 Delete Session",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{organizerToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/events/{{eventId}}/sessions/{{sessionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "events", "{{eventId}}", "sessions", "{{sessionId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Session deleted', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "EVENT-ST-019 Delete Event (Admin)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/events/{{eventId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "events", "{{eventId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Event deleted', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().message).to.exist;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Error Cases",
      "description": "Negative test cases verifying proper error responses.",
      "item": [
        {
          "name": "EVENT-ST-020 Create Event Without Auth → 401",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/events",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": \"{{categoryId}}\",\n  \"title\": \"Unauth Event\",\n  \"eventType\": \"CONFERENCE\",\n  \"description\": \"Should be rejected\",\n  \"startTime\": \"2030-11-15T09:00:00Z\",\n  \"endTime\": \"2030-11-15T18:00:00Z\",\n  \"expectedAttendees\": 100,\n  \"capacity\": 300,\n  \"estimatedBudget\": 50000\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Rejected with 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "EVENT-ST-021 Get Non-Existent Event → 404",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/events/00000000-0000-0000-0000-000000000000",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "events", "00000000-0000-0000-0000-000000000000"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
