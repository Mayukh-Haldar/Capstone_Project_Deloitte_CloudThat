{
  "name": "notification-service",
  "version": "1.0.0",
  "description": "EventZen Notification Service",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --experimental-test-isolation=none --test tests/**/*.test.js",
    "test:unit": "node --experimental-test-isolation=none --test tests/unit/**/*.test.js",
    "test:integration": "node --experimental-test-isolation=none --test tests/integration/**/*.test.js",
    "test:system:postman": "newman run postman/NotificationService.postman_collection.json -e postman/NotificationService.postman_environment.json --reporters cli,junit --reporter-junit-export postman/newman-results.xml"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.1.2",
    "@opentelemetry/auto-instrumentations-node": "^0.72.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.214.0",
    "@opentelemetry/sdk-node": "^0.214.0",
    "bullmq": "^5.56.8",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "firebase-admin": "^13.0.2",
    "handlebars": "^4.7.8",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.1",
    "jsonwebtoken": "^9.0.2",
    "kafkajs": "^2.2.4",
    "mongoose": "^8.19.3",
    "morgan": "^1.10.0",
    "nodemailer": "^6.10.1",
    "prom-client": "^15.1.3",
    "swagger-ui-dist": "^5.27.1",
    "socket.io": "^4.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.2.4",
    "newman": "^6.2.1",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4"
  }
}
