# Frontend and public URLs
APP_ROOT=/path/to/eventzen
FRONTEND_ORIGIN=https://app.example.com
AUTH_APP_BASE_URL=https://app.example.com

# Frontend
VITE_SITE_URL=https://app.example.com
VITE_AUTH_SERVICE_URL=https://api.example.com/auth-service
VITE_EVENT_SERVICE_URL=https://api.example.com/event-service
VITE_VENUE_VENDOR_SERVICE_URL=https://api.example.com/venue-vendor-service
VITE_TICKETING_SERVICE_URL=https://api.example.com/ticketing-service
VITE_FINANCE_SERVICE_URL=https://api.example.com/finance-service
VITE_NOTIFICATION_SERVICE_URL=https://api.example.com/notification-service
VITE_GOOGLE_CLIENT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# Nginx rate limiting
AUTH_RATE_LIMIT_RPS=10
AUTH_RATE_LIMIT_BURST=20
API_RATE_LIMIT_RPS=30
API_RATE_LIMIT_BURST=60

# Ports
FRONTEND_PORT=5173
MYSQL_PORT=3407
MONGODB_PORT=27018
REDIS_PORT=6379
ZOOKEEPER_PORT=2181
KAFKA_PORT=9092
KAFKA_EXTERNAL_HOST=localhost
LOKI_HOST_PORT=3301
TEMPO_HOST_PORT=3300
GRAFANA_HOST_PORT=3408
GRAFANA_ADMIN_USER=replace-with-grafana-admin-user
GRAFANA_ADMIN_PASSWORD=replace-with-grafana-admin-password

# Autoscaler
AUTOSCALER_ENABLED=true
AUTOSCALER_INTERVAL_SECONDS=60
AUTOSCALER_COOLDOWN_SECONDS=180
AUTOSCALER_SCALE_UP_THRESHOLD=75
AUTOSCALER_SCALE_DOWN_THRESHOLD=25
AUTH_SERVICE_MIN_REPLICAS=2
AUTH_SERVICE_MAX_REPLICAS=4
EVENT_SERVICE_MIN_REPLICAS=2
EVENT_SERVICE_MAX_REPLICAS=4
VENUE_VENDOR_SERVICE_MIN_REPLICAS=2
VENUE_VENDOR_SERVICE_MAX_REPLICAS=4
TICKETING_SERVICE_MIN_REPLICAS=2
TICKETING_SERVICE_MAX_REPLICAS=4
FINANCE_SERVICE_MIN_REPLICAS=2
FINANCE_SERVICE_MAX_REPLICAS=4
NOTIFICATION_SERVICE_MIN_REPLICAS=2
NOTIFICATION_SERVICE_MAX_REPLICAS=4

# Shared auth
AUTH_JWT_SECRET=replace-with-a-long-random-secret
AUTH_JWT_ISSUER=eventzen-auth-service
AUTH_CRYPTO_SECRET=replace-with-a-32-plus-char-field-encryption-secret

# Internal service auth
NOTIFICATION_INTERNAL_SERVICE_KEY=replace-with-an-internal-service-key
TICKETING_INTERNAL_SERVICE_KEY=replace-with-an-internal-service-key

# MySQL
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
AUTH_DB_USERNAME=root
AUTH_DB_PASSWORD=replace-with-auth-db-password
EVENT_DB_USERNAME=root
EVENT_DB_PASSWORD=replace-with-event-db-password
FINANCE_DB_USERNAME=root
FINANCE_DB_PASSWORD=replace-with-finance-db-password

# Auth bootstrap admin
AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
AUTH_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
AUTH_BOOTSTRAP_ADMIN_FIRST_NAME=System
AUTH_BOOTSTRAP_ADMIN_LAST_NAME=Administrator

# Auth feature flags
AUTH_PASSWORD_RESET_MINUTES=30
AUTH_EMAIL_VERIFICATION_HOURS=24
AUTH_REQUIRE_VERIFIED_EMAIL_FOR_LOGIN=false
AUTH_EXPOSE_DEBUG_TOKENS=false
AUTH_ALLOW_DEBUG_GOOGLE_TOKENS=false
AUTH_GOOGLE_CLIENT_ID=

# SMTP / email
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=587
AUTH_SMTP_USERNAME=
AUTH_SMTP_PASSWORD=
AUTH_SMTP_AUTH=true
AUTH_SMTP_STARTTLS=true
AUTH_SMTP_CONNECTION_TIMEOUT=5000
AUTH_SMTP_TIMEOUT=5000
AUTH_SMTP_WRITE_TIMEOUT=5000
AUTH_MAIL_FROM_EMAIL=no-reply@example.com
AUTH_MAIL_FROM_NAME=EventZen

NOTIFICATION_SMTP_HOST=
NOTIFICATION_SMTP_PORT=587
NOTIFICATION_SMTP_USERNAME=
NOTIFICATION_SMTP_PASSWORD=
NOTIFICATION_SMTP_AUTH=true
NOTIFICATION_SMTP_STARTTLS=true
NOTIFICATION_MAIL_FROM_EMAIL=no-reply@example.com
NOTIFICATION_MAIL_FROM_NAME=EventZen

# Event service
EVENT_CORS_ALLOWED_ORIGINS=https://app.example.com
EVENT_STORAGE_ENABLED=true

# Venue-vendor service
VENUE_VENDOR_MONGO_URI=mongodb+srv://username:password@cluster-url/eventzen_venue_vendor?retryWrites=true&w=majority

# Ticketing service
TICKETING_MONGO_CONNECTION_STRING=mongodb+srv://username:password@cluster-url/?retryWrites=true&w=majority
TICKETING_MONGO_DATABASE=ticketing_db

# Finance service
FINANCE_CORS_ALLOWED_ORIGINS=https://app.example.com
FINANCE_RAZORPAY_ENABLED=false
FINANCE_RAZORPAY_KEY_ID=
FINANCE_RAZORPAY_KEY_SECRET=
FINANCE_RAZORPAY_CHECKOUT_NAME=EventZen
FINANCE_RAZORPAY_CHECKOUT_DESCRIPTION=Event registration payment

# Notification service
NOTIFICATION_MONGO_URI=mongodb+srv://username:password@cluster-url/eventzen_notifications?retryWrites=true&w=majority
DEFAULT_NOTIFICATION_LOCALE=en
NOTIFICATION_RETENTION_DAYS=90
ENABLE_REQUEST_LOGS=true
ENABLE_KAFKA=true
KAFKA_CLIENT_ID=eventzen-notification-service
KAFKA_CONSUMER_GROUP=eventzen-notification-service
KAFKA_TOPICS=user.registered,user.password.reset,registration.confirmed,registration.cancelled,event.published,event.reminder.24h,event.reminder.1h,event.cancelled,event.updated,waitlist.promoted,payment.received,payment.failed,budget.alert.threshold,vendor.contract.signed,checkin.milestone
ENABLE_BULLMQ=true
ENABLE_SOCKET_IO=true
SEED_DEFAULT_TEMPLATES=true

# Firebase push
NOTIFICATION_FIREBASE_PROJECT_ID=
NOTIFICATION_FIREBASE_CLIENT_EMAIL=
NOTIFICATION_FIREBASE_PRIVATE_KEY=

# MinIO / storage
MINIO_ROOT_USER=replace-with-minio-user
MINIO_ROOT_PASSWORD=replace-with-minio-password
MINIO_BUCKET=eventzen-media
MINIO_PUBLIC_BASE_URL=https://storage.example.com/eventzen-media
MINIO_EVENT_BANNERS_PREFIX=event-banners
MINIO_SPEAKER_PHOTOS_PREFIX=speaker-photos
MINIO_TICKET_PASSES_PREFIX=ticket-passes
MINIO_INVOICES_PREFIX=invoices
